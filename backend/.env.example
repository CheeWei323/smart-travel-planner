MONGO_URI=mongodb+srv://YOUR_DATABASE_CONNECTION
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PORT=5000
FRONTEND_URL=https://127.0.0.1:5173
# The browser and Postman use Vite's HTTPS origin and /api proxy locally.
# The backend listener on port 5000 remains HTTP in this setup.
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Kuala_Lumpur
# Optional travel services. Trips and manual planning work without these.
WEATHER_API_KEY=
PEXELS_API_KEY=
# Used only by npm run seed:admin. Choose a new, unused email.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=Admin
