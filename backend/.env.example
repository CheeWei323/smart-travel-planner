MONGO_URI=mongodb+srv://YOUR_DATABASE_CONNECTION
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
PORT=5000
FRONTEND_URL=http://localhost:5173
# Local HTTP only. Set true when the HTTPS teammate's setup is ready.
# Production forces secure cookies and requires HTTPS FRONTEND_URL values.
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Kuala_Lumpur
# Optional travel services. Trips and manual planning work without these.
WEATHER_API_KEY=
PEXELS_API_KEY=
# Used only by npm run seed:admin. Choose a new, unused email.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=Admin
